{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLDataset",
  "description": "ML training dataset entry",
  "type": "object",
  "required": ["features", "label", "timestamp", "slot"],
  "properties": {
    "features": {
      "type": "object",
      "description": "Feature vector",
      "properties": {
        "best_bid_serum": {"type": "number"},
        "best_ask_serum": {"type": "number"},
        "best_bid_raydium": {"type": "number"},
        "best_ask_raydium": {"type": "number"},
        "best_bid_orca": {"type": "number"},
        "best_ask_orca": {"type": "number"},
        "spread_bps": {"type": "number"},
        "liquidity_serum": {"type": "number"},
        "liquidity_raydium": {"type": "number"},
        "liquidity_orca": {"type": "number"},
        "price_volatility_5s": {"type": "number"},
        "price_volatility_30s": {"type": "number"},
        "orderbook_imbalance": {"type": "number"},
        "liquidity_shock_score": {"type": "number"},
        "competing_tx_density": {"type": "number"},
        "probe_success_rate": {"type": "number"},
        "recent_tip_threshold": {"type": "number"}
      }
    },
    "label": {
      "type": "integer",
      "enum": [0, 1],
      "description": "Binary label: 1 if profitable arb exists, 0 otherwise"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "timestamp": {"type": "integer"},
        "slot": {"type": "integer"},
        "pair": {"type": "string"},
        "expected_profit_bps": {"type": "number"},
        "actual_profit_bps": {"type": "number"}
      }
    }
  }
}
