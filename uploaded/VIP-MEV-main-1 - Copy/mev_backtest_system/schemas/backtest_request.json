{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BacktestRequest",
  "description": "Request to run a backtest",
  "type": "object",
  "required": ["pair", "start_slot", "end_slot"],
  "properties": {
    "pair": {
      "type": "string",
      "description": "Trading pair",
      "example": "SOL/USDC"
    },
    "start_slot": {
      "type": "integer",
      "minimum": 0,
      "description": "Starting slot for backtest"
    },
    "end_slot": {
      "type": "integer",
      "minimum": 0,
      "description": "Ending slot for backtest"
    },
    "initial_balance": {
      "type": "number",
      "default": 50.0,
      "description": "Starting capital in SOL"
    },
    "max_slippage_bps": {
      "type": "integer",
      "default": 20,
      "description": "Maximum allowed slippage in basis points"
    },
    "min_roi_bps": {
      "type": "integer",
      "default": 5,
      "description": "Minimum required ROI in basis points"
    },
    "tip_strategy": {
      "type": "string",
      "enum": ["fixed", "adaptive", "competitive"],
      "default": "adaptive",
      "description": "Tip selection strategy"
    },
    "mode": {
      "type": "string",
      "enum": ["tick", "slot", "time_sliced"],
      "default": "slot",
      "description": "Backtest granularity mode"
    }
  }
}
